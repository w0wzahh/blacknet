[Unit]
Description=Blacknet DNS Filter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/blacknet serve --config /etc/blacknet/config.yaml
WorkingDirectory=/var/lib/blacknet
Restart=on-failure
RestartSec=5
# Port 53 needs CAP_NET_BIND_SERVICE; ambient caps avoid running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blacknet /etc/blacknet
PrivateTmp=true
User=blacknet
Group=blacknet

[Install]
WantedBy=multi-user.target
